# Скопируйте в .env и замените значения. Файл .env в git не попадает.
DB_PASSWORD=придумайте-длинный-пароль-базы
# Пароль администратора для входа на странице (раньше был записан прямо в index.html)
ADMIN_PASSWORD=4588
# Случайная строка для подписи входа, например результат команды: openssl rand -hex 32
SESSION_SECRET=замените-на-случайную-строку
# Порт на NAS, по которому открывается страница: http://IP-NAS:8095
APP_PORT=8095
# С каких сайтов можно обращаться к API (* — с любых; можно https://deniskoviktor.github.io)
ALLOWED_ORIGINS=*
TZ=Asia/Almaty
